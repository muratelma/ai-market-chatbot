services:
  postgres:
    image: postgres:16
    container_name: aimarket-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: aimarket
      POSTGRES_USER: aimarket_user
      POSTGRES_PASSWORD: aimarket_pass
    ports:
      - "5433:5432"
    volumes:
      - aimarket_postgres_data:/var/lib/postgresql/data
      # Auto-seed the catalog ONLY on a fresh/empty volume: scripts in
      # /docker-entrypoint-initdb.d run only during first-time DB init.
      # Existing volumes are untouched — reseed manually with
      # backend/scripts/seed_products_postgres.py (or psql -f).
      - ./backend/db/seed_products.sql:/docker-entrypoint-initdb.d/seed_products.sql:ro

  pgadmin:
    image: dpage/pgadmin4
    container_name: aimarket-pgadmin
    restart: unless-stopped
    environment:
      PGADMIN_DEFAULT_EMAIL: admin@example.com
      PGADMIN_DEFAULT_PASSWORD: admin123
    ports:
      - "5050:80"
    depends_on:
      - postgres

volumes:
  aimarket_postgres_data:
