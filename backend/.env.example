# Example environment configuration for the AI-Market backend.
# Copy to .env (gitignored) or export these in your shell. The app reads
# real values from the process environment; this file is documentation only.

# Where to load the product catalog from:
#   csv -> backend/products.csv (default, unchanged legacy behavior)
#   db  -> PostgreSQL via DATABASE_URL (loaded once at startup, ORDER BY id)
PRODUCT_SOURCE=csv

# PostgreSQL connection (used only when PRODUCT_SOURCE=db).
# libpq URI accepted directly by psycopg2. Matches docker-compose (host port 5433).
DATABASE_URL=postgresql://aimarket_user:aimarket_pass@localhost:5433/aimarket

# Optional: override the products table name (default: products).
# PRODUCTS_TABLE=products
