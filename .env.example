# Optional Docker Compose overrides. Docker runs with safe local-demo defaults
# when this file is not copied. Never commit the real .env file.

POSTGRES_DB=aimarket
POSTGRES_USER=aimarket_user
POSTGRES_PASSWORD=aimarket_pass

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

OLLAMA_MODEL=gemma3:4b
OLLAMA_ENABLED=true
OLLAMA_WARMUP=true
OLLAMA_KEEP_ALIVE=10m
# Defaults: CPU Compose=120 seconds, GPU override=30 seconds.
# OLLAMA_TIMEOUT_SECONDS=120

PRODUCTS_TABLE=products
AI_MARKET_RANKING_V2=true
AI_MARKET_GROUPED_RANKING=true
